.zep-root.zep-theme-ZepDark {
    /* Surfaces */
    --zep-bg-root: rgb(30, 30, 30);
    --zep-bg-pane: rgb(40, 40, 40);
    --zep-bg-asset-list-band: rgb(35, 35, 35);

    /* Borders */
    --zep-border-pane: rgb(60, 60, 60);

    /* Text */
    --zep-text-main: rgb(223, 223, 223);
    --zep-text-subtle: rgb(152, 152, 152);

    /* Inputs */
    --zep-bg-input: rgb(30, 30, 30);
    --zep-border-input: rgb(60, 60, 60);
    --zep-text-input: rgb(223, 223, 223);
    --zep-text-input-placeholder: rgb(100, 100, 100);

    /* Buttons - primary */
    --zep-bg-button-primary: rgb(10, 132, 255);
    --zep-bg-button-primary-hover: rgb(56, 151, 247);
    --zep-bg-button-primary-active: rgb(0, 112, 235);
    --zep-text-button-primary: white;

    /* Buttons - secondary */
    --zep-bg-button-secondary: rgb(50, 50, 50);
    --zep-bg-button-secondary-hover: rgb(65, 65, 65);
    --zep-bg-button-secondary-active: rgb(45, 45, 45);
    --zep-text-button-secondary: rgb(223, 223, 223);

    /* Buttons - danger */
    --zep-bg-button-danger: rgb(255, 69, 58);
    --zep-bg-button-danger-hover: rgb(246, 101, 94);
    --zep-text-button-danger: white;

    /* Item state */
    --zep-bg-item-hover: rgba(255, 255, 255, 0.1);
    --zep-bg-item-selected-accent: rgba(10, 132, 255, 0.3);
    --zep-border-item-selected-accent: rgb(10, 132, 255);

    /* Marquee */
    --zep-bg-marquee: rgba(10, 132, 255, 0.15);
    --zep-border-marquee: rgba(10, 132, 255, 0.55);

    /* Splitter */
    --zep-bg-splitter-grip: rgba(255, 255, 255, 0.1);
    --zep-bg-splitter-grip-hover: rgba(255, 255, 255, 0.2);
    --zep-bg-splitter-grip-dragging: rgba(255, 255, 255, 0.3);

    /* Status */
    --zep-bg-status-pulse: rgb(48, 209, 88);

    /* Prompt */
    --zep-bg-prompt-scrim: rgba(0, 0, 0, 0.6);
    --zep-bg-prompt-card: rgb(45, 45, 45);
    --zep-border-prompt-card: rgb(65, 65, 65);

    /* Chips & favorites */
    --zep-bg-info-chip: rgba(10, 132, 255, 0.2);
    --zep-bg-tag-favorite-active: rgb(255, 214, 10);

    /* Toggle group */
    --zep-bg-toggle-group: rgba(255, 255, 255, 0.1);
    --zep-bg-toggle-active: rgb(60, 60, 60);

    /* Tags */
    --zep-tag-selected-border: rgba(255, 255, 255, 0.9);

    /* Icons */
    --zep-icon-tint: rgb(223, 223, 223);
}
