.zep-root.zep-theme-UnityDark {
    /* Surfaces */
    --zep-bg-root: rgb(56, 56, 56);
    --zep-bg-pane: rgb(42, 42, 42);
    --zep-bg-asset-list-band: rgb(38, 38, 38);

    /* Borders */
    --zep-border-pane: rgb(36, 36, 36);

    /* Text */
    --zep-text-main: rgb(210, 210, 210);
    --zep-text-subtle: rgb(150, 150, 150);

    /* Inputs */
    --zep-bg-input: rgb(32, 32, 32);
    --zep-border-input: rgb(26, 26, 26);
    --zep-text-input: rgb(220, 220, 220);
    --zep-text-input-placeholder: rgb(100, 100, 100);

    /* Buttons - primary */
    --zep-bg-button-primary: rgb(58, 114, 176);
    --zep-bg-button-primary-hover: rgb(74, 130, 196);
    --zep-bg-button-primary-active: rgb(42, 98, 156);
    --zep-text-button-primary: rgb(255, 255, 255);

    /* Buttons - secondary */
    --zep-bg-button-secondary: rgb(88, 88, 88);
    --zep-bg-button-secondary-hover: rgb(104, 104, 104);
    --zep-bg-button-secondary-active: rgb(72, 72, 72);
    --zep-text-button-secondary: rgb(210, 210, 210);

    /* Buttons - danger */
    --zep-bg-button-danger: rgb(168, 60, 60);
    --zep-bg-button-danger-hover: rgb(188, 80, 80);
    --zep-text-button-danger: rgb(255, 255, 255);

    /* Item state */
    --zep-bg-item-hover: rgb(68, 68, 68);
    --zep-bg-item-selected-accent: rgba(58, 114, 176, 0.3);
    --zep-border-item-selected-accent: rgb(74, 130, 196);

    /* Marquee */
    --zep-bg-marquee: rgba(58, 114, 176, 0.12);
    --zep-border-marquee: rgba(58, 114, 176, 0.5);

    /* Splitter */
    --zep-bg-splitter-grip: rgba(128, 128, 128, 0.3);
    --zep-bg-splitter-grip-hover: rgba(128, 128, 128, 0.6);
    --zep-bg-splitter-grip-dragging: rgb(58, 114, 176);

    /* Status */
    --zep-bg-status-pulse: rgb(80, 220, 150);

    /* Prompt */
    --zep-bg-prompt-scrim: rgba(0, 0, 0, 0.6);
    --zep-bg-prompt-card: rgb(46, 46, 46);
    --zep-border-prompt-card: rgb(54, 54, 54);

    /* Chips & favorites */
    --zep-bg-info-chip: rgb(56, 56, 56);
    --zep-bg-tag-favorite-active: rgb(240, 190, 60);

    /* Toggle group */
    --zep-bg-toggle-group: rgb(32, 32, 32);
    --zep-bg-toggle-active: rgb(56, 56, 56);

    /* Tags */
    --zep-tag-selected-border: rgb(189, 189, 189);

    /* Icons */
    --zep-icon-tint: rgb(180, 180, 180);
}
